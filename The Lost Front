local function isVisible(part, character)
    local origin = Camera.CFrame.Position
    local direction = (part.Position - origin)

    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character, character}
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.IgnoreWater = true

    local result = workspace:Raycast(origin, direction, params)

    if not result then
        return true
    end

    -- ถ้า ray ไปโดน part ของ target = มองเห็น
    return result.Instance:IsDescendantOf(character)
end

local function getClosest()
    local bestTarget = nil
    local bestPart = nil
    local shortest = fov

    local mousePos = UserInputService:GetMouseLocation()

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer
		and v.Character
		and IsEnemy(v)
        and v.Character:FindFirstChild("HumanoidRootPart")
        and v.Character:FindFirstChild("Head")
        and (v.Team ~= LocalPlayer.Team or not teamCheck) then
            
            local char = v.Character

            local head = char:FindFirstChild("Head")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local parts = {
    char:FindFirstChild("UpperTorso"),
    char:FindFirstChild("LowerTorso"),

    char:FindFirstChild("LeftUpperArm"),
    char:FindFirstChild("RightUpperArm"),
    char:FindFirstChild("LeftLowerArm"),
    char:FindFirstChild("RightLowerArm"),

    char:FindFirstChild("LeftUpperLeg"),
    char:FindFirstChild("RightUpperLeg"),
    char:FindFirstChild("LeftLowerLeg"),
    char:FindFirstChild("RightLowerLeg")
}
			if not char:FindFirstChild("LeftUpperArm") then
    parts = {
        char:FindFirstChild("Torso"),
        char:FindFirstChild("Left Arm"),
        char:FindFirstChild("Right Arm"),
        char:FindFirstChild("Left Leg"),
        char:FindFirstChild("Right Leg")
    }
end

            local chosenPart = nil

            -- 🔥 PRIORITY 1: หัว (ถ้ามองเห็น)
            if head and isVisible(head, char) then
                chosenPart = head
            else
                -- ⚠️ PRIORITY 2: ส่วนอื่นที่โผล่
                for _, p in ipairs(parts) do
                    if p and isVisible(p, char) then
                        chosenPart = p
                        break
                    end
                end

                -- ❌ PRIORITY 3: ไม่เห็นอะไรเลย → fallback หัว
                if not chosenPart then
                    chosenPart = head
                end
            end

            if chosenPart then
                local pos, onScreen = Camera:WorldToViewportPoint(chosenPart.Position)

                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude

                    if dist < shortest then
                        shortest = dist
                        bestTarget = v
                        bestPart = chosenPart
                    end
                end
            end
        end
    end

    return bestTarget, bestPart
end

