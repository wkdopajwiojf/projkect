local function GetFadeAlpha(screenPos)
    local mouse = UserInputService:GetMouseLocation()
    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mouse).Magnitude
    
    local maxDist = 150 -- 🔴 ระยะที่เริ่มหาย (ปรับได้)
    
    local alpha = math.clamp(dist / maxDist, 0, 1)
    return alpha
end

local function GetPlayerFolder(char)
    if not char then return nil end

    if char:IsDescendantOf(FOLDER_A) then
        return "A"
    elseif char:IsDescendantOf(FOLDER_B) then
        return "B"
    end

    return nil
end

local function IsEnemy(player)
    if player == LocalPlayer then return false end
    if not player.Character or not LocalPlayer.Character then return false end

    local myFolder = GetPlayerFolder(LocalPlayer.Character)
    local enemyFolder = GetPlayerFolder(player.Character)

    if not myFolder or not enemyFolder then
        return false
    end

    return myFolder ~= enemyFolder
end

