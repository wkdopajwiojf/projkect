-- ฟังก์ชัน handle player
local function OnPlayer(p)
    -- ถ้ามีตัวละครอยู่แล้ว
    if p.Character then
        ApplySkeleton(p)
    end

    -- รอ spawn ใหม่
    local conn = p.CharacterAdded:Connect(function()
        ApplySkeleton(p)
    end)

    table.insert(Manager.Connections, conn)
end

