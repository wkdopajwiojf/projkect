function Manager:Destroy()
    -- Disconnect ทุก connection
    for _, c in pairs(self.Connections) do
        pcall(function() c:Disconnect() end)
    end

    -- ลบ Drawing ทุกตัว
    for _, obj in pairs(self.Objects) do
        pcall(function() obj:Remove() end)
    end

    -- เคลียร์ table
    self.Connections = {}
    self.Objects = {}
end

